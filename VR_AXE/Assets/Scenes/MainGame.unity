--- !u!114 &1847238562
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1847238560}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 398127f6110e68c48af8d4825c819a73, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleManager
  subtitleText: {fileID: 479154683}
  subtitleBackground: {fileID: 865002306}
  subtitles:
  - startTime: 2
    endTime: 5.7
    text: Welcome. You don't know me, but I know you.
  - startTime: 6
    endTime: 8
    text: You have spent your whole life in the light,
  - startTime: 8.4
    endTime: 10
    text: never appreciating the very air you breathe.
  - startTime: 10.5
    endTime: 12.5
    text: Now, you are in the dark.
  - startTime: 12.9
    endTime: 16.3
    text: In fifteen minutes, this room will fill with toxic gas.
  - startTime: 16.5
    endTime: 18.4
    text: The clock is ticking...
  - startTime: 18.8
    endTime: 23
    text: and the only way out is through the trials I have prepared.
  - startTime: 23.3
    endTime: 26
    text: Live or die, the choice is yours.
